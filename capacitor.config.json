{
  "appId": "com.komaread.library",
  "appName": "Komy",
  "webDir": "mobile-www",
  "server": {
    "url": "https://komy-manga.vercel.app?app=true",
    "cleartext": true,
    "allowNavigation": [
      "komy-manga.vercel.app",
      "*.vercel.app",
      "accounts.google.com",
      "*.google.com",
      "*.googleusercontent.com"
    ]
  },
  "android": {
    "overrideUserAgent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
